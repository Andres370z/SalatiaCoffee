# Copia este archivo como .env y completa los valores. NUNCA subas .env a GitHub.
PORT=3000

# Base de datos (coincide con docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=salatia
DB_PASSWORD=salatia_dev
DB_NAME=salatiacoffee

# WhatsApp Cloud API (Meta for Developers)
# Si WHATSAPP_ACCESS_TOKEN o WHATSAPP_PHONE_NUMBER_ID están vacíos, las respuestas
# se imprimen en consola en lugar de enviarse (modo simulado).
WHATSAPP_VERIFY_TOKEN=cambia_este_token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Versión de la Graph API (verifica la vigente en Meta for Developers)
WHATSAPP_API_VERSION=v23.0
# Número público de WhatsApp del negocio para los QR de las mesas (con indicativo, ej. 573001234567)
WHATSAPP_NUMERO_PUBLICO=

# Sesión del panel: secreto con el que se firman los tokens de inicio de sesión.
# Usa un texto largo y aleatorio; con NODE_ENV=production el servidor rechaza el valor de ejemplo.
JWT_SECRET=cambia_este_secreto

# Clave para crear el primer administrador con POST /auth/primer-admin (solo funciona si no
# hay usuarios). Déjala vacía para desactivar ese endpoint; quítala después de usarla.
ADMIN_INICIAL_TOKEN=
